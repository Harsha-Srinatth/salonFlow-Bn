PORT=8081
FRONTEND_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth / session
JWT_SECRET=
STAFF_ACCESS_SECRET=
STAFF_SETUP_SECRET=
REDIS_URL=

# Firebase Admin (use path OR explicit credentials)
FIREBASE_SERVICE_ACCOUNT_PATH=./credentials/firebase-admin.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client Web API key (Identity Toolkit — password reset oob verification / consume)
FIREBASE_WEB_API_KEY=

# Reverse proxy: set to 1 so rate limits & audit use X-Forwarded-For
TRUST_PROXY=

# Optional append-only JSON audit file (auth events)
AUDIT_LOG_PATH=

# Login lockout after bad passwords (per IP + email)
LOGIN_FAILS_BEFORE_LOCKOUT=5
LOGIN_LOCKOUT_MS=300000

# Staff setup JWT after phone OTP (jose duration string, e.g. 5m, 300s)
STAFF_SETUP_TOKEN_TTL=5m

# Rate limits (per IP unless noted). Window = milliseconds.
RATE_LOGIN_WINDOW_MS=900000
RATE_LOGIN_MAX=25
RATE_STAFF_LOGIN_WINDOW_MS=900000
RATE_STAFF_LOGIN_MAX=25
RATE_SESSION_WINDOW_MS=3600000
RATE_SESSION_MAX=60
RATE_PHONE_EXISTS_WINDOW_MS=3600000
RATE_PHONE_EXISTS_MAX=120
RATE_PWRESET_COMPLETE_WINDOW_MS=3600000
RATE_PWRESET_COMPLETE_MAX=10
RATE_PWRESET_REQUEST_WINDOW_MS=3600000
RATE_PWRESET_REQUEST_MAX=5
RATE_STAFF_FIREBASE_VERIFY_WINDOW_MS=3600000
RATE_STAFF_FIREBASE_VERIFY_MAX=40
RATE_STAFF_SETPW_WINDOW_MS=3600000
RATE_STAFF_SETPW_MAX=20

# Live queue & estimated wait time (SRS 4.7)
# Ticket/ownership hashes must be identical on every instance — falls back to JWT_SECRET.
QUEUE_TICKET_SECRET=
# Cache tiers: L1 is per-process, L2 is shared (Redis/ElastiCache).
QUEUE_ROWS_L1_TTL_MS=1000
QUEUE_ROWS_L2_TTL_MS=5000
QUEUE_SERVICE_STATS_TTL_MS=300000
QUEUE_PROJECTION_RESOLUTION_MS=1000
# Realtime push cadence and payload cap.
QUEUE_BROADCAST_INTERVAL_MS=5000
QUEUE_PUBLIC_MAX_ENTRIES=40
# Estimation model.
QUEUE_OVERRUN_TAIL_MINUTES=5
QUEUE_MINIMUM_SAMPLE_SIZE=3
QUEUE_CONFIDENT_SAMPLE_SIZE=8
QUEUE_SERVICE_STATS_WINDOW_DAYS=30
QUEUE_MAX_ROWS=2000
# "Your turn is coming up" notification.
QUEUE_REMINDER_LEAD_MINUTES=15
QUEUE_REMINDER_SWEEP_INTERVAL_MS=60000
QUEUE_REMINDER_RETENTION_DAYS=7
RATE_QUEUE_LIVE_WINDOW_MS=60000
RATE_QUEUE_LIVE_MAX=240
CACHE_L1_MAX_ENTRIES=500
REDIS_CONNECT_TIMEOUT_MS=3000

# Stripe (backend-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Razorpay (backend-only; TEST keys are rzp_test_..., LIVE keys are rzp_live_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Optional: minutes an unpaid checkout stays open before it is marked EXPIRED (default 30)
# RAZORPAY_ORDER_TTL_MINUTES=30
# Optional: set to false to allow bookings to be confirmed without online payment (default: payment required)
# ONLINE_PAYMENT_REQUIRED=true

# Salon time zone (IANA). Booking hours, "today" and invoices use it. Default Asia/Kolkata.
# SALON_TIMEZONE=Asia/Kolkata

# AI agents (support assistant, admin insights, service-content drafter).
# Without a key the support assistant still works in rule-based "basic" mode.
ANTHROPIC_API_KEY=
# Optional: model id (default claude-opus-5-5) and per-call timeout.
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_LLM_TIMEOUT_MS=45000
# Optional: set to true to force basic mode (e.g. during an incident or to cap spend).
# ASSISTANT_LLM_DISABLED=false
# Assistant rate limits (per signed-in user; guests per IP get the *_PUBLIC_* values).
# RATE_ASSISTANT_MAX=12
# RATE_ASSISTANT_PUBLIC_MAX=6
# RATE_ASSISTANT_DAILY_MAX=150
# RATE_ASSISTANT_PUBLIC_DAILY_MAX=40
# RATE_ASSISTANT_IP_MAX=60
# AGENT_RUN_RETENTION_DAYS=90
