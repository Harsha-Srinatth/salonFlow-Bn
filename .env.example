PORT=8081
FRONTEND_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth / session
JWT_SECRET=
STAFF_ACCESS_SECRET=
STAFF_SETUP_SECRET=
REDIS_URL=

# Firebase Admin (use path OR explicit credentials)
FIREBASE_SERVICE_ACCOUNT_PATH=./credentials/firebase-admin.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client Web API key (Identity Toolkit — password reset oob verification / consume)
FIREBASE_WEB_API_KEY=

# Reverse proxy: set to 1 so rate limits & audit use X-Forwarded-For
TRUST_PROXY=

# Optional append-only JSON audit file (auth events)
AUDIT_LOG_PATH=

# Login lockout after bad passwords (per IP + email)
LOGIN_FAILS_BEFORE_LOCKOUT=5
LOGIN_LOCKOUT_MS=300000

# Staff setup JWT after phone OTP (jose duration string, e.g. 5m, 300s)
STAFF_SETUP_TOKEN_TTL=5m

# Rate limits (per IP unless noted). Window = milliseconds.
RATE_LOGIN_WINDOW_MS=900000
RATE_LOGIN_MAX=25
RATE_STAFF_LOGIN_WINDOW_MS=900000
RATE_STAFF_LOGIN_MAX=25
RATE_SESSION_WINDOW_MS=3600000
RATE_SESSION_MAX=60
RATE_PHONE_EXISTS_WINDOW_MS=3600000
RATE_PHONE_EXISTS_MAX=120
RATE_PWRESET_COMPLETE_WINDOW_MS=3600000
RATE_PWRESET_COMPLETE_MAX=10
RATE_PWRESET_REQUEST_WINDOW_MS=3600000
RATE_PWRESET_REQUEST_MAX=5
RATE_STAFF_FIREBASE_VERIFY_WINDOW_MS=3600000
RATE_STAFF_FIREBASE_VERIFY_MAX=40
RATE_STAFF_SETPW_WINDOW_MS=3600000
RATE_STAFF_SETPW_MAX=20

# Live queue & estimated wait time (SRS 4.7)
# Ticket/ownership hashes must be identical on every instance — falls back to JWT_SECRET.
QUEUE_TICKET_SECRET=
# Cache tiers: L1 is per-process, L2 is shared (Redis/ElastiCache).
QUEUE_ROWS_L1_TTL_MS=1000
QUEUE_ROWS_L2_TTL_MS=5000
QUEUE_SERVICE_STATS_TTL_MS=300000
QUEUE_PROJECTION_RESOLUTION_MS=1000
# Realtime push cadence and payload cap.
QUEUE_BROADCAST_INTERVAL_MS=5000
QUEUE_PUBLIC_MAX_ENTRIES=40
# Estimation model.
QUEUE_OVERRUN_TAIL_MINUTES=5
QUEUE_MINIMUM_SAMPLE_SIZE=3
QUEUE_CONFIDENT_SAMPLE_SIZE=8
QUEUE_SERVICE_STATS_WINDOW_DAYS=30
QUEUE_MAX_ROWS=2000
# "Your turn is coming up" notification.
QUEUE_REMINDER_LEAD_MINUTES=15
QUEUE_REMINDER_SWEEP_INTERVAL_MS=60000
QUEUE_REMINDER_RETENTION_DAYS=7
RATE_QUEUE_LIVE_WINDOW_MS=60000
RATE_QUEUE_LIVE_MAX=240
CACHE_L1_MAX_ENTRIES=500
REDIS_CONNECT_TIMEOUT_MS=3000

# Razorpay (backend-only; TEST keys are rzp_test_..., LIVE keys are rzp_live_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Optional: minutes an unpaid checkout stays open before it is marked EXPIRED (default 30)
# RAZORPAY_ORDER_TTL_MINUTES=30
# Optional: set to false to allow bookings to be confirmed without online payment (default: payment required)
# ONLINE_PAYMENT_REQUIRED=true

# Salon time zone (IANA). Booking hours, "today" and invoices use it. Default Asia/Kolkata.
# SALON_TIMEZONE=Asia/Kolkata

# AI agents (support assistant, admin insights, service-content drafter).
# Without a key the support assistant still works in rule-based "basic" mode.
ANTHROPIC_API_KEY=
# Optional: model id (default claude-opus-5-5) and per-call timeout.
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_LLM_TIMEOUT_MS=45000
# Optional: set to true to force basic mode (e.g. during an incident or to cap spend).
# ASSISTANT_LLM_DISABLED=false
# Assistant rate limits (per signed-in user; guests per IP get the *_PUBLIC_* values).
# RATE_ASSISTANT_MAX=12
# RATE_ASSISTANT_PUBLIC_MAX=6
# RATE_ASSISTANT_DAILY_MAX=150
# RATE_ASSISTANT_PUBLIC_DAILY_MAX=40
# RATE_ASSISTANT_IP_MAX=60
# AGENT_RUN_RETENTION_DAYS=90

# Revenue telemetry (off by default). When true, every payment is also recorded in `revenue_events`
# with its salon-local hour and weekday (no customer details) for demand analysis / dynamic pricing.
# The admin live revenue chart works without it.
REVENUE_TELEMETRY_ENABLED=false

# Membership checkout stays open this many minutes before it is closed as expired (default 30, minimum 5).
# MEMBERSHIP_CHECKOUT_TTL_MINUTES=30

# ---------------------------------------------------------------------------------------
# WhatsApp Cloud API (Meta). Backend only: never put these in the frontend (VITE_*) env.
# Off unless WHATSAPP_ENABLED=true. In production, once enabled, every value marked
# "required" must be set or the server refuses to start. Check with: npm run whatsapp:check
WHATSAPP_ENABLED=false
# required: System User permanent access token (Business Settings > System users), with
# whatsapp_business_messaging + whatsapp_business_management on your WABA
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
# required: numeric Phone number ID (WhatsApp Manager / App dashboard > WhatsApp > API Setup). NOT the phone number.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# optional (used by npm run whatsapp:check to verify templates): WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
# required in production: App secret (App dashboard > App settings > Basic) - verifies webhook signatures
WHATSAPP_APP_SECRET=your_meta_app_secret
# required in production: any random string (16+ chars) you also type into the Meta webhook settings
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verification_token
WHATSAPP_GRAPH_API_VERSION=v26.0

# Approved template names. A message type is OFF while its template is empty.
WHATSAPP_TEMPLATE_LANGUAGE=en
# AUTHENTICATION template with a copy-code button (registration / sign-in / staff setup codes)
WHATSAPP_TEMPLATE_OTP=
# UTILITY template, body {{1}} = first name
WHATSAPP_TEMPLATE_WELCOME=
# UTILITY template, body {{1}} name {{2}} services {{3}} date {{4}} time {{5}} stylist {{6}} booking ref {{7}} salon phone
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=
# MARKETING template, body {{1}} name {{2}} offer {{3}} valid until (+ a "Stop promotions" opt-out button)
WHATSAPP_TEMPLATE_OFFER=
# Not in the default budget (WHATSAPP_MONTHLY_LIMIT_BOOKING_UPDATES=0 keeps them off even if set):
# WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
# WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=
# WHATSAPP_TEMPLATE_BOOKING_CANCELLED=
# Per-template language override, e.g. WHATSAPP_TEMPLATE_OTP_LANGUAGE=en_US

# Monthly caps per type (salon calendar month). 0 = off. When a cap is reached that type stops until next month.
WHATSAPP_MONTHLY_LIMIT_OTP=1000
WHATSAPP_MONTHLY_LIMIT_WELCOME=1000
WHATSAPP_MONTHLY_LIMIT_REMINDER=2000
WHATSAPP_MONTHLY_LIMIT_OFFER=1000
WHATSAPP_MONTHLY_LIMIT_BOOKING_UPDATES=0
# Phone-OTP sign-in for existing customers (uses the OTP budget). false = email/Google sign-in only.
WHATSAPP_OTP_LOGIN_ENABLED=true

# Reminders: minutes before the appointment (default 24 h and 2 h). Ones that would fire
# within WHATSAPP_REMINDER_MIN_LEAD_MINUTES of booking are not scheduled.
WHATSAPP_REMINDER_OFFSETS_MINUTES=1440,120
WHATSAPP_REMINDER_MIN_LEAD_MINUTES=30

# OTP policy (defaults shown)
# WHATSAPP_OTP_LENGTH=6
# WHATSAPP_OTP_TTL_SECONDS=300
# WHATSAPP_OTP_MAX_ATTEMPTS=5
# WHATSAPP_OTP_RESEND_COOLDOWN_SECONDS=45
# WHATSAPP_OTP_MAX_PER_PHONE_PER_HOUR=5
# WHATSAPP_OTP_MAX_PER_IP_PER_HOUR=20
# WHATSAPP_OTP_ALLOWED_COUNTRY_CODES=91
# WHATSAPP_PHONE_PROOF_TTL_SECONDS=1800
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Local development only (refused in production): accept this fixed code and send nothing.
# WHATSAPP_DEV_FIXED_OTP=123456

# Worker / API (defaults shown)
# WHATSAPP_WORKER_INTERVAL_MS=15000
# WHATSAPP_WORKER_BATCH_SIZE=20
# WHATSAPP_SEND_MAX_ATTEMPTS=5
# WHATSAPP_WORKER_LEASE_SECONDS=120
# WHATSAPP_REQUEST_TIMEOUT_MS=10000
# WHATSAPP_CAMPAIGN_MAX_RECIPIENTS=1000
# RATE_WHATSAPP_OTP_REQUEST_MAX=10
# RATE_WHATSAPP_OTP_VERIFY_MAX=30
